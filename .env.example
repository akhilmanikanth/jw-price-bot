# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Telegram (required) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your personal chat id - message @userinfobot on Telegram to get it.
TELEGRAM_CHAT_ID=123456789
# Optional: extra chat ids allowed to use /check (comma separated)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Schedule ---
TIMEZONE=Australia/Sydney
SCHEDULE_DAY_OF_WEEK=fri
SCHEDULE_HOUR=15
SCHEDULE_MINUTE=0

# --- Scraping ---
# Comma separated subset. Accepts retailers ("bws"), product keys
# ("jw-black-700") or exact listings ("bws:jw-black-700"). Empty = all.
ENABLED_RETAILERS=
USE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true
HTTP_TIMEOUT=25
PAGE_TIMEOUT_MS=45000
MAX_RETRIES=3
RETRY_BACKOFF=2

# --- Bot mode (python main.py bot) ---
# false (default) = this machine only answers commands; the GitHub Actions run
# sends the Friday summary. true = this machine also runs the weekly job.
RUN_WEEKLY_JOB=false

# --- Storage / logging ---
# Note: bot mode defaults to data/history-local.json when HISTORY_PATH is
# unset, so the cloud-committed data/history.json never conflicts on git pull.
HISTORY_PATH=data/history.json
TARGETS_PATH=data/targets.json
CUSTOM_PRODUCTS_PATH=data/products-custom.json
STATE_PATH=data/state.json
LOG_DIR=logs
LOG_LEVEL=INFO
# Set to a folder to save raw HTML when a scrape fails - very handy for fixing selectors.
DEBUG_DUMP_DIR=
